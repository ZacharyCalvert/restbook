@startuml
!theme crt-green
together {
collections "API Gateway" as gateway
collections  "REST API 1" as r1
collections  "REST API 2" as r2
collections  "REST API 3" as r3
}
agent SIEM as siem
r1 -down-> siem : Correlated events
r2 -down-> siem : Correlated events
r3 -down-> siem : Correlated events
gateway -down-> siem : Access events including IP data\nand collected trace context
@enduml
